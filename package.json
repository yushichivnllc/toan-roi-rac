{
  "name": "roi-rac-study-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Ứng dụng ôn luyện Toán rời rạc — Chương 3: Ô-tô-mát & ngôn ngữ hình thức",
  "main": "server.js",
  "scripts": {
    "start": "npm run build && node server.js",
    "dev": "node server.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "install:client": "npm --prefix client install",
    "build:exercise-data": "node scripts/build-exercise-data.js",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^4.21.2",
    "gsap": "^3.14.1"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "puppeteer-core": "^25.12.0"
  }
}
